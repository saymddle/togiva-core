{
  "name": "togiva-core",
  "private": true,
  "version": "0.1.0",
  "description": "TOGIVA Core: reusable multi-tenant customer engagement platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run typecheck",
    "db:migrate": "pnpm --filter @togiva/database migrate",
    "db:seed:dev": "pnpm --filter @togiva/database seed:dev",
    "openapi": "pnpm --filter @togiva/api-contracts openapi",
    "dev:api": "pnpm --filter @togiva/api dev",
    "dev:worker": "pnpm --filter @togiva/api worker"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
